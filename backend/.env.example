# E-Santé Backend Configuration
# Exemple de fichier de configuration - Renommer en .env

# ===== DATABASE CONFIGURATION =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=esante_db
DB_CHARSET=utf8mb4

# ===== API CONFIGURATION =====
API_VERSION=1.0.0
API_BASE_URL=http://192.168.8.104/esante/backend/public
FRONTEND_BASE_URL=http://localhost:8080

# ===== JWT CONFIGURATION =====
JWT_SECRET_KEY=esante_jwt_secret_key_2026_v1_super_secure
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400

# ===== ERROR LOGGING =====
LOG_LEVEL=error
LOG_FILE=/path/to/logs/error.log

# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=true
