              _ServiceCard(icon: Icons.video_call, title: 'Consultations Vidéo', description: 'Parlez avec un médecin en temps réel', delay: 0),
              _ServiceCard(icon: Icons.medication_liquid, title: 'Ordonnances', description: 'Recevez vos ordonnances digitales', delay: 100),
              _ServiceCard(icon: Icons.health_and_safety, title: 'Dossiers Médicaux', description: 'Tous vos documents en un seul endroit', delay: 200),
              _ServiceCard(icon: Icons.favorite, title: 'Suivi Vital', description: 'Suivez votre santé en continu', delay: 300),
              _ServiceCard(icon: Icons.calendar_today, title: 'Prise de RDV', description: 'Réservez facilement vos consultations', delay: 400),
              _ServiceCard(icon: Icons.chat, title: 'Support 24/7', description: 'Une aide toujours disponible', delay: 500),
            ],
          ),
        ],
      ),
    );
  }
}

class _ServiceCard extends StatefulWidget {
  final IconData icon;
  final String title;
  final String description;
  final int delay;

  const _ServiceCard({
    required this.icon,
    required this.title,
    required this.description,
    required this.delay,
  });

  @override
  State<_ServiceCard> createState() => _ServiceCardState();
}

class _ServiceCardState extends State<_ServiceCard> {
  bool _hovered = false;

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      onEnter: (_) => setState(() => _hovered = true),
      onExit: (_) => setState(() => _hovered = false),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 250),
        padding: const EdgeInsets.all(28),
        decoration: BoxDecoration(
          color: _C.white,
          border: Border.all(color: _hovered ? _C.gold : _C.border, width: 1.5),
          borderRadius: BorderRadius.circular(16),
          boxShadow: _hovered
              ? [BoxShadow(color: _C.gold.withValues(alpha: 0.15), blurRadius: 24, offset: const Offset(0, 8))]
              : [BoxShadow(color: _C.navy.withValues(alpha: 0.05), blurRadius: 12)],
        ),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.start,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Container(
              width: 40, height: 40,
              decoration: BoxDecoration(
                color: _C.gold.withValues(alpha: 0.1),
                borderRadius: BorderRadius.circular(20),
              ),
              child: Icon(widget.icon, color: _C.gold, size: 20),
            ),
            const SizedBox(height: 20),
            Text(widget.title,
              style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w700, color: _C.navy),
            ),
            const SizedBox(height: 12),
            Expanded(
              child: Text(widget.description,
                style: const TextStyle(fontSize: 13, color: _C.stone, height: 1.6),
              ),
            ),
          ],
        ),
      ),
    ).animate().fadeIn(duration: 500.ms, delay: Duration(milliseconds: widget.delay)).slideY(begin: 0.04);
  }
}

