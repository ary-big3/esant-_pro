class _StatCard extends StatelessWidget {
  final String value;
  final String label;
  final int delay;

  const _StatCard({required this.value, required this.label, required this.delay});

  @override
  Widget build(BuildContext context) {
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        Text(value,
          style: const TextStyle(fontSize: 36, fontWeight: FontWeight.w800, color: _C.gold),
        ).animate().scaleXY(begin: 0.8, duration: 600.ms, delay: Duration(milliseconds: delay)),
        const SizedBox(height: 12),
        Text(label,
          textAlign: TextAlign.center,
          style: const TextStyle(fontSize: 14, color: _C.white, fontWeight: FontWeight.w500),
        ).animate().fadeIn(duration: 600.ms, delay: Duration(milliseconds: delay + 100)),
      ],
    );
  }
}

