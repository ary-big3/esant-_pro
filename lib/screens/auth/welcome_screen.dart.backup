class _HeroStat extends StatelessWidget {
  final String value;
  final String label;
  const _HeroStat({required this.value, required this.label});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Text(value, style: const TextStyle(fontSize: 28, fontWeight: FontWeight.w800, color: _C.gold))
            .animate().scaleXY(begin: 0.8, duration: 600.ms, delay: 200.ms),
        const SizedBox(height: 8),
        Text(label, style: const TextStyle(fontSize: 14, color: _C.white, fontWeight: FontWeight.w500))
            .animate().fadeIn(duration: 600.ms, delay: 300.ms),
      ],
    );
  }
}

