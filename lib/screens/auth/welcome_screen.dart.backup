        padding: const EdgeInsets.all(28),
        child: Column(
          children: [
            Container(
              width: 80, height: 80,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: _hovered ? _C.gold.withValues(alpha: 0.2) : _C.gold.withValues(alpha: 0.1),
              ),
              child: Icon(Icons.person, color: _hovered ? _C.gold : _C.navy, size: 40),
            ),
            const SizedBox(height: 20),
            Text(widget.name,
              textAlign: TextAlign.center,
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.w700,
                color: _hovered ? _C.gold : _C.navy,
              ),
            ),
            const SizedBox(height: 8),
            Text(widget.specialty,
              textAlign: TextAlign.center,
              style: TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w600,
                color: _hovered ? _C.white : _C.stone,
              ),
            ),
            const SizedBox(height: 12),
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(Icons.star, color: _C.gold, size: 16),
                const SizedBox(width: 6),
                Text('${widget.rating}',
                  style: TextStyle(
                    fontSize: 13,
                    fontWeight: FontWeight.w600,
                    color: _hovered ? _C.gold : _C.navy,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 16),
            Divider(color: _hovered ? _C.gold.withValues(alpha: 0.3) : _C.border),
            const SizedBox(height: 16),
            Text('${widget.experience} d\'expérience',
