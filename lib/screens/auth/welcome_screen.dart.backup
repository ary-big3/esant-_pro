class _ProcessStep extends StatelessWidget {
  final String number;
  final String title;
  final String description;
  final int delay;

  const _ProcessStep({
    required this.number,
    required this.title,
    required this.description,
    required this.delay,
  });

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Container(
          width: 60, height: 60,
          decoration: const BoxDecoration(
            shape: BoxShape.circle,
            gradient: LinearGradient(colors: [_C.gold, _C.goldDeep]),
          ),
          child: Center(
            child: Text(number,
              style: const TextStyle(fontSize: 24, fontWeight: FontWeight.w800, color: _C.white),
            ),
          ),
        ).animate().scaleXY(begin: 0.8, duration: 600.ms, delay: Duration(milliseconds: delay)),
        const SizedBox(height: 20),
        Text(title,
          textAlign: TextAlign.center,
          style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w700, color: _C.navy),
        ).animate().fadeIn(duration: 600.ms, delay: Duration(milliseconds: delay + 100)),
        const SizedBox(height: 8),
        Text(description,
          textAlign: TextAlign.center,
          style: const TextStyle(fontSize: 13, color: _C.stone),
        ).animate().fadeIn(duration: 600.ms, delay: Duration(milliseconds: delay + 200)),
      ],
    );
  }
}

