// ─── BENEFITS ─────────────────────────────────────────────────────────────────

class _BenefitsSection extends StatelessWidget {
  final bool isMobile;
  const _BenefitsSection({required this.isMobile});

  static const _benefits = [
    (Icons.lock_outline_rounded,       'Sécurité militaire',   'Chiffrement AES-256, conformité RGPD et audits de sécurité réguliers protègent l\'intégralité de vos données de santé.'),
    (Icons.support_agent_outlined,     'Support 24h / 24',     'Une équipe médicale et technique disponible à tout moment pour répondre à vos questions.'),
    (Icons.workspace_premium_outlined, 'Experts certifiés',    'Tous nos praticiens sont certifiés, vérifiés et régulièrement évalués pour garantir une qualité de soin irréprochable.'),
  ];

  @override
  Widget build(BuildContext context) {
    return Container(
      color: _C.white,
      width: double.infinity,
      padding: EdgeInsets.symmetric(
        horizontal: isMobile ? 24 : 72,
        vertical: isMobile ? 72 : 112,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _SectionPill(label: 'Pourquoi nous'),
          const SizedBox(height: 18),
          _SectionHeadline(text: 'Qualité, sécurité\net confiance.', isMobile: isMobile),
          const SizedBox(height: 64),

          isMobile
              ? Column(
                  children: List.generate(_benefits.length, (i) => Padding(
                    padding: EdgeInsets.only(bottom: i < _benefits.length - 1 ? 16 : 0),
                    child: _BenefitRow(
                      icon: _benefits[i].$1,
                      title: _benefits[i].$2,
                      description: _benefits[i].$3,
                      delay: Duration(milliseconds: 100 * i),
                    ),
                  )),
                )
              : Row(
                  children: List.generate(_benefits.length, (i) => Expanded(
                    child: Padding(
                      padding: EdgeInsets.only(right: i < _benefits.length - 1 ? 24 : 0),
                      child: _BenefitCard(
                        icon: _benefits[i].$1,
                        title: _benefits[i].$2,
                        description: _benefits[i].$3,
                        delay: Duration(milliseconds: 100 * i),
                        index: i,
                      ),
                    ),
                  )),
                ),
        ],
      ),
    );
  }
}

class _BenefitCard extends StatefulWidget {
  final IconData icon;
  final String title, description;
  final Duration delay;
  final int index;
  const _BenefitCard({required this.icon, required this.title, required this.description, required this.delay, required this.index});

  @override
  State<_BenefitCard> createState() => _BenefitCardState();
}

class _BenefitCardState extends State<_BenefitCard> {
  bool _hover = false;

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      cursor: SystemMouseCursors.click,
      onEnter: (_) => setState(() => _hover = true),
      onExit:  (_) => setState(() => _hover = false),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 250),
        curve: Curves.easeOutCubic,
        padding: const EdgeInsets.all(32),
        decoration: BoxDecoration(
          color: _hover ? _C.navy : _C.silk,
          borderRadius: BorderRadius.circular(20),
          border: Border.all(
            color: _hover ? _C.gold : _C.borderFaint,
            width: _hover ? 1.5 : 1.0,
          ),
          boxShadow: _hover
              ? [BoxShadow(color: _C.gold.withValues(alpha: 0.20), blurRadius: 28, offset: const Offset(0, 10))]
              : [BoxShadow(color: Colors.black.withValues(alpha: 0.04), blurRadius: 10, offset: const Offset(0, 3))],
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // Number badge
            AnimatedContainer(
              duration: const Duration(milliseconds: 250),
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
              decoration: BoxDecoration(
                color: _hover ? _C.gold.withValues(alpha: 0.15) : _C.gold.withValues(alpha: 0.10),
                borderRadius: BorderRadius.circular(6),
              ),
              child: Text(
                '0${widget.index + 1}',
                style: const TextStyle(fontSize: 11, color: _C.gold, fontWeight: FontWeight.w800, letterSpacing: 0.5),
              ),
            ),
            const SizedBox(height: 24),
            // Icon
            AnimatedContainer(
              duration: const Duration(milliseconds: 250),
              width: 52, height: 52,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: _hover ? _C.gold.withValues(alpha: 0.14) : _C.white,
                border: Border.all(color: _hover ? _C.gold : _C.border),
              ),
              child: Icon(widget.icon, size: 23, color: _C.gold),
            ),
            const SizedBox(height: 22),
            AnimatedDefaultTextStyle(
              duration: const Duration(milliseconds: 250),
              style: TextStyle(
                fontSize: 15,
                fontWeight: FontWeight.w700,
                color: _hover ? _C.white : _C.navy,
                letterSpacing: -0.3,
                height: 1.3,
              ),
              child: Text(widget.title),
            ),
            const SizedBox(height: 10),
            AnimatedDefaultTextStyle(
              duration: const Duration(milliseconds: 250),
              style: TextStyle(
                fontSize: 13,
                color: _hover ? const Color(0xFF9AADA2) : _C.stone,
                height: 1.7,
              ),
              child: Text(widget.description),
            ),
          ],
        ),
      ),
    ).animate().fadeIn(duration: 500.ms, delay: widget.delay)
     .slideY(begin: 0.04, end: 0, duration: 500.ms, delay: widget.delay);
  }
}

class _BenefitRow extends StatefulWidget {
  final IconData icon;
  final String title, description;
  final Duration delay;
  const _BenefitRow({required this.icon, required this.title, required this.description, required this.delay});

  @override
  State<_BenefitRow> createState() => _BenefitRowState();
}

class _BenefitRowState extends State<_BenefitRow> {
  bool _hover = false;

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      onEnter: (_) => setState(() => _hover = true),
      onExit:  (_) => setState(() => _hover = false),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 220),
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          color: _hover ? _C.navy : _C.silk,
          borderRadius: BorderRadius.circular(16),
          border: Border.all(color: _hover ? _C.gold : _C.borderFaint),
        ),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            AnimatedContainer(
              duration: const Duration(milliseconds: 220),
              width: 46, height: 46,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: _hover ? _C.gold.withValues(alpha: 0.14) : _C.white,
                border: Border.all(color: _hover ? _C.gold : _C.border),
              ),
              child: Icon(widget.icon, size: 21, color: _C.gold),
            ),
            const SizedBox(width: 16),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  AnimatedDefaultTextStyle(
                    duration: const Duration(milliseconds: 220),
                    style: TextStyle(fontSize: 14, fontWeight: FontWeight.w700, color: _hover ? _C.white : _C.navy, letterSpacing: -0.2),
                    child: Text(widget.title),
                  ),
                  const SizedBox(height: 5),
                  AnimatedDefaultTextStyle(
                    duration: const Duration(milliseconds: 220),
                    style: TextStyle(fontSize: 12, color: _hover ? const Color(0xFF9AADA2) : _C.stone, height: 1.6),
                    child: Text(widget.description, maxLines: 2, overflow: TextOverflow.ellipsis),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    ).animate().fadeIn(duration: 500.ms, delay: widget.delay);
  }
}

