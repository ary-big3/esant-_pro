// ─── WELCOME SCREEN ───────────────────────────────────────────────────────────

class WelcomeScreen extends StatefulWidget {
  const WelcomeScreen({super.key});

  @override
  State<WelcomeScreen> createState() => _WelcomeScreenState();
}

class _WelcomeScreenState extends State<WelcomeScreen> {
  late ScrollController _scrollController;
  bool _showMenu = false;

  @override
  void initState() {
    super.initState();
    _scrollController = ScrollController();
  }

  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }

  void _scrollToSection(double offset) {
    _scrollController.animateTo(
      offset,
      duration: const Duration(milliseconds: 800),
      curve: Curves.easeInOutCubic,
    );
    setState(() => _showMenu = false);
  }

  @override
  Widget build(BuildContext context) {
    final w = MediaQuery.of(context).size.width;
    final isMobile = w < 768;

    return Scaffold(
      backgroundColor: _C.white,
      body: SafeArea(
        child: Stack(
          children: [
            SingleChildScrollView(
              controller: _scrollController,
              child: Column(
                children: [
                  _Navbar(
                    isMobile: isMobile,
                    onMenuPressed: () => setState(() => _showMenu = !_showMenu),
                    onServicesPressed: () => _scrollToSection(800),
                  ),
                  _Hero(isMobile: isMobile),
                  _ServicesSection(isMobile: isMobile),
                  _StatsSection(isMobile: isMobile),
                  _AboutSection(isMobile: isMobile),
                  _BenefitsSection(isMobile: isMobile),
                  _CtaSection(isMobile: isMobile),
                  _Footer(isMobile: isMobile),
                ],
              ),
            ),
            // Mobile menu overlay
            if (_showMenu && isMobile)
              GestureDetector(
                onTap: () => setState(() => _showMenu = false),
                child: Container(
                  color: Colors.black26,
                  child: Align(
                    alignment: Alignment.topRight,
                    child: Container(
                      width: 250,
                      height: double.infinity,
                      color: _C.white,
                      child: ListView(
                        padding: const EdgeInsets.only(top: 20),
                        children: [
                          Padding(
                            padding: const EdgeInsets.all(20),
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'Menu',
                                  style: TextStyle(
                                    fontSize: 20,
                                    fontWeight: FontWeight.w800,
                                    color: _C.navy,
                                  ),
                                ),
                                const SizedBox(height: 24),
                                _MenuItem(
                                  label: 'Nos services',
                                  onTap: () => _scrollToSection(800),
                                ),
                                const SizedBox(height: 16),
                                _MenuItem(
                                  label: 'À propos',
                                  onTap: () => _scrollToSection(1600),
                                ),
                                const SizedBox(height: 16),
                                _MenuItem(
                                  label: 'Avantages',
                                  onTap: () => _scrollToSection(2000),
                                ),
                                const SizedBox(height: 32),
                                _PrimaryBtn(
                                  label: 'Connexion',
                                  onPressed: () {
                                    Navigator.of(context).push(
                                      MaterialPageRoute(
                                        builder: (_) => const LoginScreen(),
                                      ),
                                    );
                                  },
                                  compact: true,
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}

// ─── NAVBAR ──────────────────────────────────────────────────────────────────

class _Navbar extends StatelessWidget {
  final bool isMobile;
  final VoidCallback? onMenuPressed;
  final VoidCallback? onServicesPressed;
  
  const _Navbar({
    required this.isMobile,
    this.onMenuPressed,
    this.onServicesPressed,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      color: _C.white,
      padding: EdgeInsets.symmetric(
        horizontal: isMobile ? 24 : 72,
        vertical: 22,
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          // ── Logo ──
          Row(
            children: [
              _GoldCircleIcon(size: 46, iconSize: 22, icon: Icons.health_and_safety_rounded),
              const SizedBox(width: 14),
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text('E-Santé',
                    style: TextStyle(
                      fontSize: isMobile ? 19 : 21,
                      fontWeight: FontWeight.w800,
                      color: _C.navy,
                      letterSpacing: -0.6,
                    )),
                  const Text('Plateforme médicale',
                    style: TextStyle(
                      fontSize: 10,
                      color: _C.gold,
                      fontWeight: FontWeight.w600,
                      letterSpacing: 1.0,
                    )),
                ],
              ),
            ],
          ).animate().fadeIn(duration: 600.ms),

          // ── Actions ──
          if (!isMobile)
            Row(
              children: [
                TextButton(
                  onPressed: () => _push(context, const LoginScreen()),
                  style: TextButton.styleFrom(
                    foregroundColor: _C.charcoal,
                    padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 12),
                  ),
                  child: const Text('Connexion',
                    style: TextStyle(fontWeight: FontWeight.w600, fontSize: 14, letterSpacing: -0.2)),
                ),
                const SizedBox(width: 10),
                _PrimaryBtn(
                  label: "S'inscrire",
                  onPressed: () => _push(context, const RegisterScreen()),
                  compact: true,
                ),
              ],
            ).animate().fadeIn(duration: 600.ms, delay: 100.ms)
          else
            _NavIconBtn(onPressed: onMenuPressed ?? () {}),
        ],
      ),
    );
  }
}

// ─── MENU ITEM ────────────────────────────────────────────────────────────────

class _MenuItem extends StatefulWidget {
  final String label;
  final VoidCallback onTap;
  const _MenuItem({required this.label, required this.onTap});

  @override
  State<_MenuItem> createState() => _MenuItemState();
}

class _MenuItemState extends State<_MenuItem> {
  bool _hover = false;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: widget.onTap,
      child: MouseRegion(
        onEnter: (_) => setState(() => _hover = true),
        onExit: (_) => setState(() => _hover = false),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
          decoration: BoxDecoration(
            color: _hover ? _C.silk : Colors.transparent,
            borderRadius: BorderRadius.circular(8),
          ),
          child: Text(
            widget.label,
            style: TextStyle(
              fontSize: 15,
              fontWeight: FontWeight.w600,
              color: _hover ? _C.gold : _C.navy,
              letterSpacing: -0.2,
            ),
          ),
        ),
      ),
    );
  }
}

class _NavIconBtn extends StatelessWidget {
  final VoidCallback onPressed;
  const _NavIconBtn({required this.onPressed});

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onPressed,
      child: Container(
        width: 40, height: 40,
        decoration: BoxDecoration(
          color: _C.silk,
          borderRadius: BorderRadius.circular(10),
          border: Border.all(color: _C.border),
        ),
        child: const Icon(Icons.menu_rounded, color: _C.navy, size: 20),
      ),
    );
  }
}

// ─── HERO ─────────────────────────────────────────────────────────────────────

class _Hero extends StatelessWidget {
  final bool isMobile;
  const _Hero({required this.isMobile});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      decoration: BoxDecoration(
        image: const DecorationImage(
          image: AssetImage("assets/images/cli.png"),
          fit: BoxFit.cover,
        ),
        gradient: LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [
            Colors.black.withValues(alpha: 0.65),
            Colors.blue.withValues(alpha: 0.45),
          ],
        ),
      ),
      padding: EdgeInsets.symmetric(
        horizontal: isMobile ? 24 : 72,
        vertical: isMobile ? 60 : 104,
      ),
      child: isMobile ? _HeroMobile() : _HeroDesktop(),
    );
  }
}

class _HeroDesktop extends StatelessWidget {
  const _HeroDesktop();

  @override
  Widget build(BuildContext context) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.center,
      children: [
        Expanded(
          flex: 6,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Pill badge
              _PillBadge(label: 'Certifié ISO 27001 · RGPD conforme')
                  .animate().fadeIn(duration: 500.ms).slideX(begin: -0.04, end: 0),

              const SizedBox(height: 36),

              // Headline
              RichText(
                text: const TextSpan(
                  style: TextStyle(
                    fontSize: 68,
                    fontWeight: FontWeight.w800,
                    color: _C.white,
                    height: 1.04,
                    letterSpacing: -2.5,
                  ),
                  children: [
                    TextSpan(text: 'La santé\n'),
                    TextSpan(text: 'digitale, '),
                    TextSpan(
                      text: 'réinventée.',
                      style: TextStyle(color: _C.gold),
                    ),
                  ],
                ),
              ).animate().fadeIn(duration: 700.ms, delay: 80.ms)
               .slideY(begin: 0.03, end: 0, duration: 700.ms, delay: 80.ms),

              const SizedBox(height: 30),

              const Text(
                'Patients et spécialistes réunis sur une plateforme\nsécurisée, intuitive et disponible en permanence.',
                style: TextStyle(
                  fontSize: 17,
                  color: Color(0xFFE8E8E8),
                  height: 1.85,
                  letterSpacing: -0.2,
                  fontWeight: FontWeight.w400,
                ),
              ).animate().fadeIn(duration: 600.ms, delay: 180.ms),

              const SizedBox(height: 52),

              Row(
                children: [
                  _PrimaryBtn(
                    label: 'Prendre rendez-vous',
                    onPressed: () => _push(context, const RegisterScreen()),
                  ),
                  const SizedBox(width: 14),
                  _OutlineBtn(label: 'Nos services', onPressed: () {}),
                ],
              ).animate().fadeIn(duration: 600.ms, delay: 260.ms),

              const SizedBox(height: 60),

              // Trust badges
              Row(
                children: const [
                  _TrustChip(icon: Icons.verified_rounded, label: '500+ spécialistes'),
                  SizedBox(width: 16),
                  _TrustChip(icon: Icons.groups_2_outlined, label: '150 000 patients'),
                  SizedBox(width: 16),
                  _TrustChip(icon: Icons.star_rounded, label: '4.9 / 5'),
                ],
              ).animate().fadeIn(duration: 600.ms, delay: 340.ms),
            ],
          ),
        ),
        const Spacer(flex: 4),
      ],
    );
  }
}

