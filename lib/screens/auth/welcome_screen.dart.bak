// ─── SERVICES ─────────────────────────────────────────────────────────────────

class _ServicesSection extends StatelessWidget {
  final bool isMobile;
  const _ServicesSection({required this.isMobile});

  static const _services = [
    (Icons.description_outlined,       'Dossier Médical',      'Accédez à votre historique médical complet, sécurisé et disponible sur tous vos appareils.'),
    (Icons.calendar_month_outlined,    'Rendez-vous',          'Planifiez vos consultations avec nos spécialistes en temps réel, sans attente.'),
    (Icons.receipt_long_outlined,      'Ordonnances',          'Gérez vos prescriptions numériques et renouvellements en quelques clics.'),
    (Icons.science_outlined,           "Résultats d'analyses", 'Consultez vos examens avec une interprétation médicale claire et détaillée.'),
    (Icons.video_call_outlined,        'Téléconsultation',     'Consultez un médecin à distance en vidéo HD, sécurisée et confidentielle.'),
    (Icons.notifications_none_rounded, 'Alertes',              'Rappels personnalisés pour vos rendez-vous, traitements et renouvellements.'),
  ];

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      color: _C.silk,
      padding: EdgeInsets.symmetric(
        horizontal: isMobile ? 24 : 72,
        vertical: isMobile ? 72 : 112,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    _SectionPill(label: 'Services'),
                    const SizedBox(height: 18),
                    _SectionHeadline(text: 'Tout ce dont\nvous avez besoin.', isMobile: isMobile),
                  ],
                ),
              ),
              if (!isMobile)
                _OutlineBtn(label: 'Voir tout', onPressed: () {}),
            ],
          ),
          const SizedBox(height: 64),

          // ── Circular service cards ──
          isMobile
              ? _MobileServiceGrid(services: _services)
              : _DesktopServiceRow(services: _services),
        ],
      ),
    );
  }
}

class _DesktopServiceRow extends StatelessWidget {
  final List<(IconData, String, String)> services;
  const _DesktopServiceRow({required this.services});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: List.generate(3, (i) => Padding(
            padding: EdgeInsets.only(right: i < 2 ? 36 : 0),
            child: _ServiceCircle(
              icon: services[i].$1,
              title: services[i].$2,
              description: services[i].$3,
              delay: Duration(milliseconds: 80 * i),
            ),
          )),
        ),
        const SizedBox(height: 36),
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: List.generate(3, (i) => Padding(
            padding: EdgeInsets.only(right: i < 2 ? 36 : 0),
            child: _ServiceCircle(
              icon: services[i + 3].$1,
              title: services[i + 3].$2,
              description: services[i + 3].$3,
              delay: Duration(milliseconds: 80 * (i + 3)),
            ),
          )),
        ),
      ],
    );
  }
}

class _MobileServiceGrid extends StatelessWidget {
  final List<(IconData, String, String)> services;
  const _MobileServiceGrid({required this.services});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: List.generate((services.length / 2).ceil(), (row) {
        final left  = row * 2;
        final right = left + 1;
        return Padding(
          padding: const EdgeInsets.only(bottom: 20),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              _ServiceCircle(
                icon: services[left].$1,
                title: services[left].$2,
                description: services[left].$3,
                delay: Duration(milliseconds: 80 * left),
                size: 120,
              ),
              const SizedBox(width: 20),
              if (right < services.length)
                _ServiceCircle(
                  icon: services[right].$1,
                  title: services[right].$2,
                  description: services[right].$3,
                  delay: Duration(milliseconds: 80 * right),
                  size: 120,
                )
              else
                const SizedBox(width: 120),
            ],
          ),
        );
      }),
    );
  }
}

class _ServiceCircle extends StatefulWidget {
  final IconData icon;
  final String title, description;
  final Duration delay;
  final double size;

  const _ServiceCircle({
    required this.icon,
    required this.title,
    required this.description,
    required this.delay,
    this.size = 148,
  });

  @override
  State<_ServiceCircle> createState() => _ServiceCircleState();
}

class _ServiceCircleState extends State<_ServiceCircle> {
  bool _hover = false;

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      cursor: SystemMouseCursors.click,
      onEnter: (_) => setState(() => _hover = true),
      onExit:  (_) => setState(() => _hover = false),
      child: Tooltip(
        message: widget.description,
        textStyle: const TextStyle(fontSize: 12, color: _C.white, height: 1.5),
        decoration: BoxDecoration(
          color: _C.navy,
          borderRadius: BorderRadius.circular(10),
          border: Border.all(color: _C.gold.withValues(alpha: 0.3)),
        ),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 260),
          curve: Curves.easeOutCubic,
          width: widget.size,
          height: widget.size,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: _hover ? _C.navy : _C.white,
            border: Border.all(
              color: _hover ? _C.gold : _C.border,
              width: _hover ? 2.0 : 1.0,
            ),
            boxShadow: _hover
                ? [
                    BoxShadow(color: _C.gold.withValues(alpha: 0.22), blurRadius: 28, spreadRadius: 0, offset: const Offset(0, 8)),
                    BoxShadow(color: _C.navy.withValues(alpha: 0.15), blurRadius: 12, offset: const Offset(0, 4)),
                  ]
                : [
                    BoxShadow(color: Colors.black.withValues(alpha: 0.055), blurRadius: 12, offset: const Offset(0, 4)),
                    BoxShadow(color: _C.gold.withValues(alpha: 0.04), blurRadius: 20, offset: const Offset(0, 8)),
                  ],
          ),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              // Gold ring icon
              AnimatedContainer(
                duration: const Duration(milliseconds: 260),
                width: widget.size * 0.32,
                height: widget.size * 0.32,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: _hover
                      ? _C.gold.withValues(alpha: 0.14)
                      : const Color(0xFFF4EFE5),
                  border: Border.all(
                    color: _hover ? _C.gold : _C.border,
                    width: 1.0,
                  ),
                ),
                child: Icon(
                  widget.icon,
                  size: widget.size * 0.155,
                  color: _C.gold,
                ),
              ),
              SizedBox(height: widget.size * 0.075),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 10),
                child: AnimatedDefaultTextStyle(
                  duration: const Duration(milliseconds: 260),
                  style: TextStyle(
                    fontSize: widget.size < 130 ? 10 : 11.5,
                    fontWeight: FontWeight.w700,
                    color: _hover ? _C.white : _C.navy,
                    letterSpacing: -0.1,
                    height: 1.3,
                  ),
                  child: Text(widget.title, textAlign: TextAlign.center, maxLines: 2),
                ),
              ),
            ],
          ),
        ),
      ),
    ).animate().fadeIn(duration: 450.ms, delay: widget.delay)
     .scaleXY(begin: 0.86, end: 1, duration: 500.ms, delay: widget.delay, curve: Curves.easeOutBack);
  }
}

// ─── STATS ────────────────────────────────────────────────────────────────────

class _StatsSection extends StatelessWidget {
  final bool isMobile;
  const _StatsSection({required this.isMobile});

  static const _stats = [
    ('150 000+', 'Patients accompagnés'),
    ('500+',     'Spécialistes certifiés'),
    ('99.9%',    'Disponibilité garantie'),
    ('4.9 / 5',  'Satisfaction patients'),
  ];

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [_C.navy, _C.navyMid, Color(0xFF0D1E38)],
        ),
      ),
      padding: EdgeInsets.symmetric(
        horizontal: isMobile ? 24 : 72,
        vertical: isMobile ? 60 : 88,
      ),
      child: Column(
        children: [
          // Decorative top line
          Container(
            width: 60,
            height: 2,
            margin: const EdgeInsets.only(bottom: 56),
            decoration: BoxDecoration(
              gradient: const LinearGradient(colors: [_C.gold, _C.goldDeep]),
              borderRadius: BorderRadius.circular(1),
            ),
          ),
          GridView.builder(
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: isMobile ? 2 : 4,
              mainAxisSpacing: isMobile ? 36 : 0,
              crossAxisSpacing: 0,
              childAspectRatio: isMobile ? 1.5 : 2.0,
            ),
            itemCount: _stats.length,
            itemBuilder: (_, i) {
              final s = _stats[i];
              final isLast = i == _stats.length - 1;
              final isLastMobileRow = isMobile && i >= 2;
              return Container(
                padding: EdgeInsets.symmetric(horizontal: isMobile ? 8 : 0),
                decoration: BoxDecoration(
                  border: Border(
                    right: (!isLast && !isMobile)
                        ? const BorderSide(color: Color(0x22FFFFFF), width: 1)
                        : BorderSide.none,
                  ),
                ),
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    // Gold dot
                    Container(
                      width: 6, height: 6,
                      margin: const EdgeInsets.only(bottom: 16),
                      decoration: const BoxDecoration(
                        color: _C.gold,
                        shape: BoxShape.circle,
                      ),
                    ),
                    Text(
                      s.$1,
                      style: const TextStyle(
                        fontSize: 40,
                        fontWeight: FontWeight.w200,
                        color: _C.white,
                        letterSpacing: -2.0,
                        height: 1.0,
                      ),
                    ).animate().fadeIn(duration: 600.ms, delay: Duration(milliseconds: 120 * i)),
                    const SizedBox(height: 10),
                    Text(
                      s.$2,
                      style: const TextStyle(
                        fontSize: 12,
                        color: Color(0xFF8A9DB5),
                        letterSpacing: 0.3,
                        fontWeight: FontWeight.w500,
                      ),
                    ).animate().fadeIn(duration: 600.ms, delay: Duration(milliseconds: 120 * i + 100)),
                  ],
                ),
              );
            },
          ),
        ],
      ),
    );
  }
}

